<%- include('./partials/header'); %>

<div class="max-w-screen-xl mx-auto px-6 py-20">

  <!-- Breadcrumb -->
  <div class="text-sm text-gray-500 mb-4">
    <a href="/">Home</a> &nbsp;•&nbsp;
    <!-- <a href="/category/<%= product.category %>"><%= product.category.name %></a> &nbsp;•&nbsp; -->
    <span class="text-black font-medium"><%= product.name %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <!-- Left Side - Images -->
    <div class="flex gap-4">
      <!-- Thumbnails -->
      <div class="flex flex-col space-y-3">
        <% product.images.forEach((img, i) => { %>
          <img
            src="<%= img %>"
            alt="thumb"
            class="thumbnail w-16 h-16 object-cover border rounded cursor-pointer hover:ring-2 ring-pink-400"
            onclick="changeMainImage('<%= img %>', this)"
          >
        <% }) %>
      </div>

      <!-- Main Image with Zoom Lens -->
      <div class="relative">
        <div class="zoom-container border rounded-lg">
          <img
            id="mainImage"
            src="<%= product.images[0] %>"
            alt="<%= product.name %>"
            class="w-full h-[500px] object-cover"
          />
          <div class="zoom-lens" id="zoomLens"></div>
        </div>
        <div class="zoom-result shadow-lg rounded-lg" id="zoomResult"></div>
      </div>
    </div>

    <!-- Right Side - Details -->
    <div>
      <p class="text-sm text-gray-500"> <%= product.category.name %> </p>
      <h1 class="text-3xl font-bold mb-2"><%= product.name %></h1>

      <div class="flex items-center space-x-4 mb-4">
        <p class="text-2xl font-semibold text-pink-700">Rs. <%= product.price %></p>
        <% if (product.originalPrice) { %>
          <p class="text-lg text-gray-400 line-through">Rs. <%= product.originalPrice %></p>
        <% } %>
      </div>

      <!-- Quantity selector -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
        <div class="flex items-center border w-max rounded">
          <button class="px-3 py-1 text-lg">−</button>
          <input type="number" value="1" min="1" class="w-12 text-center outline-none">
          <button class="px-3 py-1 text-lg">+</button>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
        <button class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-6 py-3 rounded">
          Add to Cart
        </button>
        <button class="bg-black hover:bg-gray-800 text-white font-semibold px-6 py-3 rounded flex items-center gap-2">
          🛒 Buy Now
        </button>
      </div>

      <!-- Razorpay note -->
      <div class="mt-6 text-sm text-gray-500 border p-3 rounded shadow">
        All payment modes available 
        <span class="float-right">Secured by 
          <img src="https://cdn.razorpay.com/static/assets/logo.svg" alt="razorpay" class="inline w-20" />
        </span>
      </div>

      <!-- Info -->
      <div class="mt-6 text-sm text-gray-600">
        <p><strong>Category:</strong> <%= product.category.name %></p> <br>
        <p><strong>Description:</strong> <br> <br> <%= product.description %></p>
      </div>
    </div>
  </div>
</div>

<style>
  .zoom-container {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 500px;
  }

  .zoom-lens {
    position: absolute;
    border: 1px solid #ccc;
    width: 100px;
    height: 100px;
    opacity: 0.4;
    background: #fff;
    cursor: crosshair;
    display: none;
    z-index: 2;
    pointer-events: none;
  }

  .zoom-result {
    position: absolute;
    top: 0;
    left: 105%;
    width: 300px;
    height: 300px;
    border: 1px solid #ddd;
    background-repeat: no-repeat;
    background-size: 200%;
    display: none;
    z-index: 10;
    pointer-events: none;
  }
</style>

<script>
    const mainImage = document.getElementById("mainImage");
    const zoomLens = document.getElementById("zoomLens");
    const zoomResult = document.getElementById("zoomResult");
    const zoomContainer = document.querySelector(".zoom-container");
    const zoomFactor = 2;
  
    function moveLens(e) {
      const bounds = zoomContainer.getBoundingClientRect();
      const x = e.clientX - bounds.left;
      const y = e.clientY - bounds.top;
  
      const lensWidth = zoomLens.offsetWidth / 2;
      const lensHeight = zoomLens.offsetHeight / 2;
  
      let lensX = x - lensWidth;
      let lensY = y - lensHeight;
  
      lensX = Math.max(0, Math.min(lensX, zoomContainer.offsetWidth - zoomLens.offsetWidth));
      lensY = Math.max(0, Math.min(lensY, zoomContainer.offsetHeight - zoomLens.offsetHeight));
  
      zoomLens.style.left = lensX + "px";
      zoomLens.style.top = lensY + "px";
  
      zoomResult.style.backgroundSize = `${mainImage.offsetWidth * zoomFactor}px ${mainImage.offsetHeight * zoomFactor}px`;
      zoomResult.style.backgroundPosition = `-${lensX * zoomFactor}px -${lensY * zoomFactor}px`;
    }
  
    zoomContainer.addEventListener("mousemove", moveLens);
  
    zoomContainer.addEventListener("mouseenter", () => {
      zoomLens.style.display = "block";
      zoomResult.style.display = "block";
      zoomResult.style.backgroundImage = `url('${mainImage.src}')`;
    });
  
    zoomContainer.addEventListener("mouseleave", () => {
      zoomLens.style.display = "none";
      zoomResult.style.display = "none";
    });
  
    function changeMainImage(src, thumbnail) {
      mainImage.src = src;
      zoomResult.style.backgroundImage = `url('${src}')`;
  
      document.querySelectorAll('.thumbnail').forEach(img => {
        img.classList.remove('ring-2', 'ring-pink-400');
      });
      thumbnail.classList.add('ring-2', 'ring-pink-400');
    }
  </script>
  

<%- include('./partials/footer'); %>
