<%- include('./partials/header'); %>

<body class="bg-gradient-to-tr from-pink-50 via-purple-50 to-blue-50 min-h-screen">

  <!-- Go Back Navbar -->
  <nav class="bg-transparent p-4 sticky top-28 z-50">
    <div class="max-w-6xl mx-auto flex items-center">
      <button onclick="window.history.back()" class="flex items-center text-black hover:text-blue-800 font-medium transition">
        <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
        Go Back
      </button>
    </div>
  </nav>

  <!-- Orders Section -->
  <div class="max-w-4xl mx-auto mt-10 px-4 mb-20 min-h-[40vh]">
    <div class="bg-white/80 backdrop-blur-md shadow-xl rounded-2xl p-8 border border-gray-200">
      <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Your Orders</h1>

      <% if (orders && orders.length > 0) { %>
        <div class="space-y-6">
          <% orders.forEach(order => { %>
            <div class="bg-gray-50 p-6 rounded-lg shadow-md border border-gray-200">
              <div class="flex justify-between items-center mb-2">
                <h2 class="font-semibold text-gray-700 text-sm">Order ID: <%= order._id %></h2>
                <span class="text-xs px-3 py-1 rounded-full 
                  <% if(order.status === 'Delivered'){ %> bg-green-100 text-green-700 
                  <% } else if(order.status === 'Shipped'){ %> bg-blue-100 text-blue-700 
                  <% } else { %> bg-yellow-100 text-yellow-700 <% } %>">
                  <%= order.status %>
                </span>
              </div>
              <p class="text-sm text-gray-600 mb-4">Placed on: <%= order.createdAt.toDateString() %></p>

              <ul class="list-disc ml-5 text-sm text-gray-700 mb-2">
                <% if (order.products && Array.isArray(order.products)) { %>
                  <% order.products.forEach(item => { %>
                    <li><%= item.product.name %> × <%= item.quantity %></li>
                  <% }) %>
                <% } else { %>
                  <li>No products in this order.</li>
                <% } %>
              </ul>
              

              <p class="text-sm text-gray-600">
                <span class="font-medium text-gray-700">Shipping to:</span> <%= order.address %>
              </p>
              
              <div class="text-right mt-3 font-semibold text-gray-800">
                Total: ₹<%= order.totalAmount %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center text-gray-600">
          <p class="text-lg font-medium">You have no orders yet.</p>
          <a href="/" class="mt-4 inline-block text-sm text-blue-600 hover:underline">Go to Shop</a>
        </div>
      <% } %>
    </div>
  </div>

<%- include('./partials/footer'); %>
</body>
