<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whimsy</title>
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
     <!-- Swiper CSS -->
    <!-- <link rel="stylesheet" href="/swiper/swiper-bundle.min.css" /> -->
   
    <script src="https://unpkg.com/@studio-freight/lenis"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Lobster&display=swap" rel="stylesheet">
    


    <link href="/css/output.css" rel="stylesheet">
</head>

<body class="bg-gray-100">
    <!-- Modern Navbar -->
    <nav class="bg-gray-900 text-white sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Brand -->
                <div class="flex items-center space-x-2">
                    <span class="text-xl font-bold tracking-wide text-blue-400">AdminPanel</span>
                </div>

                <!-- Nav Links -->
                <div class="hidden md:flex space-x-6">
                    <a href="/" class="hover:text-blue-400 transition duration-200">Home</a>
                    <a href="/admin/products" class="hover:text-blue-400 transition duration-200">Products</a>
                    <a href="/admin/orders" class="hover:text-blue-400 transition duration-200">Orders</a>
                </div>

                <!-- Logout -->
                <div class="flex items-center space-x-4">
                    <form action="/admin/logout" method="GET">
                        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Dashboard -->
    <div class="flex flex-col min-h-screen">
        <main class="flex-1 overflow-y-auto">
            <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
                <!-- Dashboard Overview -->

                  
                <div class="mb-8 bg-white shadow-lg rounded-lg p-6">
                    <h2 class="text-2xl font-semibold text-gray-800">Dashboard Overview</h2>
                    <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-gradient-to-r from-blue-500 to-blue-700 p-6 rounded-lg shadow-md text-white">
                            <h3 class="text-lg font-medium">Total Products</h3>
                            <p class="mt-2 text-3xl font-bold"><%= totalProducts %></p>
                        </div>
                        <div class="bg-gradient-to-r from-green-500 to-green-700 p-6 rounded-lg shadow-md text-white">
                            <h3 class="text-lg font-medium">Total Categories</h3>
                            <p class="mt-2 text-3xl font-bold"><%= categoryCount %></p>
                        </div>
                        <div class="bg-gradient-to-r from-yellow-500 to-yellow-700 p-6 rounded-lg shadow-md text-white">
                            <h3 class="text-lg font-medium">New Orders</h3>
                            <p class="mt-2 text-3xl font-bold"><%= newOrders %></p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Product Form -->
                    <div class="bg-white shadow-lg rounded-lg p-6">
                        <h2 class="text-2xl font-semibold text-gray-800">Manage Products</h2>
                        <form autocomplete="off" class="mt-4 space-y-4" action="/products" enctype="multipart/form-data" method="POST">
                            <h3 class="text-lg font-medium text-gray-700">Create Product</h3>
                            <input type="text" name="name" placeholder="Product Name" maxlength="99" required class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
<input id="price" type="number" name="price" placeholder="Product Price" required 
       class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">


                            <select name="category" required class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">-- Select Category --</option>
                                <% categories.forEach(function(category) { %>
                                    <option value="<%= category._id %>"><%= category.name %></option>
                                <% }) %>
                            </select>

                            <!-- new -->
                             <input type="text" name="weight" placeholder="Weight (e.g. 250g, 1kg)" 
                                      class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">

                             <textarea name="ingredients" placeholder="Ingredients (comma separated)" rows="3"
                              class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>

                             <textarea name="about" placeholder="About the product" rows="3" maxlength="900"
                             class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>

                             <!-- end -->
                            <!-- <textarea name="description" placeholder="Product Description" rows="4" class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea> -->
                            <input type="number" name="stock" placeholder="Stock Quantity" required class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <input type="file" name="images" multiple required class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">

                            <button type="submit" class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition">
                                Create Product
                            </button>
                        </form>

                        <!-- Delete Product -->
                        <form autocomplete="off" class="mt-6 space-y-4" action="/products/delete" method="POST">
                            <h3 class="text-lg font-medium text-gray-700">Delete Product</h3>
                            <input type="text" name="product_id" placeholder="Product ID" required class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-red-500">
                            <button type="submit" class="w-full bg-red-600 text-white py-3 px-4 rounded-lg hover:bg-red-700 transition">
                                Delete Product
                            </button>
                        </form>
                    </div>

                   <!-- Category Form -->
<div class="bg-white shadow-lg rounded-lg p-6">
    <h2 class="text-2xl font-semibold text-gray-800">Manage Categories</h2>
    <form autocomplete="off" class="mt-4 space-y-4" action="/category/add" method="POST">
      <h3 class="text-lg font-medium text-gray-700">Create or Update Category</h3>
      <input type="text" name="name" placeholder="Category Name" required
        class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500">
      
      <label class="block text-sm font-medium text-gray-700">Category Color</label>
      <input type="color" name="color" value="#000000"
        class="w-full h-12 p-1 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500">
  
      <button type="submit"
        class="w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 transition">
        Save Category
      </button>
    </form>
  </div>

  <!-- Newsletter Form -->
<div class="bg-white shadow-lg rounded-lg p-6 mt-6">
    <h2 class="text-2xl font-semibold text-gray-800">Send Newsletter</h2>
    
    <% if (success && success.length > 0) { %>
        <div class="bg-green-100 text-green-800 p-3 rounded mt-4"><%= success[0] %></div>
      <% } %>
      <% if (error && error.length > 0) { %>
        <div class="bg-red-100 text-red-800 p-3 rounded mt-4"><%= error[0] %></div>
      <% } %>
      
      
  
    <form action="/admin/newsletter/send" method="POST" class="mt-4 space-y-4">
      <input type="text" name="subject" placeholder="Subject" required
        class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-indigo-500">
      
      <textarea name="message" placeholder="Your message" rows="5" required
        class="w-full p-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
  
      <button type="submit"
        class="w-full bg-indigo-600 text-white py-3 px-4 rounded-lg hover:bg-indigo-700 transition">
        Send to All Subscribers
      </button>
    </form>
  </div>
  
  
                </div>
            </div>
        </main>
    </div>
    


    
</body>

<%- include('./partials/footer'); %>

