<%- include('partials/header') %>

<div class="max-w-3xl mx-auto p-6 bg-white rounded-lg shadow mt-10 min-h-[50vh]">
  <h2 class="text-2xl font-bold text-gray-800 mb-4">Confirm Your Order</h2>

  <div class="mb-6 text-gray-700">
    <h3 class="font-semibold mb-2">Shipping to:</h3>
    <p><%= address.street %>, <%= address.city %>, <%= address.state %> - <%= address.zipCode %>, <%= address.country %></p>
  </div>

  <div class="mb-6 text-gray-700">
    <h3 class="font-semibold mb-2">Order Summary:</h3>
    <ul class="list-disc pl-5 space-y-1">
      <% cart.forEach(item => { %>
        <li><%= item.product.name %> × <%= item.quantity %> = ₹<%= (item.product.price * item.quantity).toFixed(2) %></li>
      <% }) %>
    </ul>

    <div class="mt-4">
      <p>Subtotal: ₹<%= subtotal %></p>
      <p>Shipping: <%= shipping === 0 ? "Free" : `₹${shipping}` %></p>
      <p class="font-semibold mt-2 text-lg">Total: ₹<%= total %></p>
    </div>
  </div>
  <form action="/cart/orders/fake-success" method="POST">

    <!-- You can later change this to Razorpay button -->
    <button
      type="submit"
      class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded transition"
    >
      Confirm & Place Order
    </button>
  </form>
</div>

<%- include('partials/footer') %>
