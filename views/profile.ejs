<%- include('./partials/header'); %>

<body class="bg-gradient-to-tr from-pink-50 via-purple-50 to-blue-50 min-h-screen">

  <!-- Navbar with Go Back Button -->
  <nav class="bg-transparent  p-4 sticky top-28 z-50">
    <div class="max-w-6xl mx-auto flex items-center">
      <button onclick="window.history.back()" class="flex items-center text-black hover:text-blue-800 font-medium transition">
        <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
        Go Back
      </button>
    </div>
  </nav>

  <!-- Profile Card -->
  <div class="max-w-2xl mx-auto mt-10 px-4 mb-20">
    <div class="bg-white/80 backdrop-blur-md shadow-xl rounded-2xl p-8 space-y-6 border border-gray-200">
      <h1 class="text-3xl font-extrabold text-center text-gray-800">Your Profile</h1>

      <% if (!user) { %>
        <div class="text-center text-red-600 font-semibold">
          You are not logged in.
        </div>
        <div class="text-center mt-4">
          <a href="/users/login"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-full shadow transition">
            Login
          </a>
        </div>
      <% } else { %>

        <!-- User Info -->
        <div class="text-gray-700 space-y-2">
          <p><span class="font-semibold">Name:</span> <%= user.name %></p>
          <p><span class="font-semibold">Email:</span> <%= user.email %></p>
        </div>

        <!-- Address Section -->
        <div class="pt-4">
          <% if (user.addresses && user.addresses.length > 0) { %>
            <h2 class="text-lg font-semibold mb-2 text-gray-800">Saved Address</h2>
            <div class="bg-gray-100 p-4 rounded-lg text-gray-700 space-y-1">
              <% const addr = user.addresses[0]; %>
              <p><strong>Phone:</strong> <%= user.phone %></p>
              <p><strong>Street:</strong> <%= addr.street %></p>
              <p><strong>City:</strong> <%= addr.city %></p>
              <p><strong>State:</strong> <%= addr.state %></p>
              <p><strong>Zip Code:</strong> <%= addr.zipCode %></p>
              <p><strong>Country:</strong> <%= addr.country %></p>
            </div>

            <!-- Update Address -->
            <form action="/users/profile/address" method="POST" class="mt-6 space-y-3">
              <h3 class="font-semibold text-gray-800">Update Address</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <input type="text" name="phone" placeholder="Phone Number" pattern="\d{10}" required
                  value="<%= user.phone %>"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 outline-none" />
                <input type="text" name="street" placeholder="Street" required value="<%= addr.street %>"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 outline-none" />
                <input type="text" name="city" placeholder="City" required value="<%= addr.city %>"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 outline-none" />
                <input type="text" name="state" placeholder="State" required value="<%= addr.state %>"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 outline-none" />
                <input type="text" name="zipCode" placeholder="Zip Code" required value="<%= addr.zipCode %>"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 outline-none" />
                <input type="text" name="country" placeholder="Country" required value="<%= addr.country %>"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 outline-none" />
              </div>
              <button type="submit"
                class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-md shadow transition">
                Update Address
              </button>
            </form>

          <% } else { %>
            <h2 class="text-lg font-semibold mb-2 text-gray-800">Add Address</h2>
            <form action="/users/profile/address" method="POST" class="space-y-3">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <input type="text" name="phone" placeholder="Phone Number" pattern="\d{10}" required value="<%= user.phone %>"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-green-400 outline-none" />
                <input type="text" name="street" placeholder="Street" required
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-green-400 outline-none" />
                <input type="text" name="city" placeholder="City" required
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-green-400 outline-none" />
                <input type="text" name="state" placeholder="State" required
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-green-400 outline-none" />
                <input type="text" name="zipCode" placeholder="Zip Code" required
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-green-400 outline-none" />
                <input type="text" name="country" placeholder="Country" required value="India"
                  class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-green-400 outline-none" />
              </div>
              <button type="submit"
                class="w-full bg-green-500 hover:bg-green-600 text-white py-2 rounded-md shadow transition">
                Add Address
              </button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('./partials/footer'); %>
</body>
