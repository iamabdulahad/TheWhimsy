<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <title>Reset Password</title>
  </head>
  <body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <form
      action="/users/reset-password/<%= token %>"
      method="POST"
      class="bg-white p-6 rounded shadow-md w-full max-w-sm"
    >
      <h2 class="text-xl font-bold mb-4 text-center">Reset Password</h2>

      <input
        type="password"
        name="password"
        placeholder="New Password"
        required
        class="w-full px-3 py-2 mb-4 border border-gray-300 rounded"
      />
      <button
        type="submit"
        class="w-full bg-purple-600 text-white py-2 rounded hover:bg-purple-700"
      >
        Update Password
      </button>
    </form>
  </body>
</html>
