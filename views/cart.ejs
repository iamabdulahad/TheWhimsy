<%- include('./partials/header'); %>





<nav class="bg-transparent ml-10 mt-10 z-50">
  <div class="w-full mx-auto flex items-start">
    <button onclick="window.history.back()" class="flex items-center text-black hover:text-blue-800 font-medium transition">
      <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
      
    </button>
  </div>
</nav>


<div class="container mx-auto px-4 py-8 ">
  <h1 class="text-3xl font-bold mb-6 text-gray-900">Your Cart</h1>

  <% if (cart.length === 0) { %>
  <div class="bg-white rounded-lg shadow-md p-6 text-center">
    <svg
      class="w-16 h-16 mx-auto text-gray-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
      ></path>
    </svg>
    <h2 class="mt-4 text-xl font-semibold text-gray-900">Your cart is empty</h2>
    <p class="mt-2 text-gray-600">
      Looks like you haven't added any products to your cart yet.
    </p>
    <a
      href="/"
      class="mt-4 inline-block bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded"
    >
      Continue Shopping
    </a>
  </div>
  <% } else { %>
  <div class="lg:flex lg:space-x-6">
    <!-- Cart Items -->
    <div class="lg:w-2/3">
      <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
        <!-- Mobile Cart Summary -->
        <div class="lg:hidden p-4 bg-gray-50 border-b border-gray-200">
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Total (<%= cart.length %> items)</span>
            <span class="font-bold text-lg text-gray-900">₹<%= total %></span>
          </div>
          <a
            href="<%= user ? '/cart/checkout' : '/auth/login?redirect=/cart/checkout' %>"
            class="mt-2 w-full block text-center bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded"
          >
            <%= user ? 'Proceed to Checkout' : 'Login to Checkout' %>
          </a>
        </div>

        <!-- Cart Items List -->
        <div class="divide-y divide-gray-200">
          <% cart.forEach((item) => { %>
          <div class="p-4 sm:p-6 flex flex-col sm:flex-row">
            <a href="/products/<%= item.product._id %>" class="flex-shrink-0 w-full sm:w-32 h-32 mb-4 sm:mb-0 flex items-center justify-center">
              <img
                class="max-h-full max-w-full object-contain rounded"
                src="<%= item.product.images && item.product.images.length > 0 ? item.product.images[0] : '/images/placeholder.jpg' %>"
                alt="<%= item.product.name %>"
              />
            </a>
            <div class="flex-1 sm:ml-6 flex flex-col justify-between">
              <div class="flex flex-col sm:flex-row sm:justify-between">
                <div>
                  <h3 class="text-lg font-medium text-gray-900"><%= item.product.name %></h3>
                  <p class="mt-1 text-sm text-gray-500">₹<%= item.product.price %> each</p>
                </div>
                <div class="mt-4 sm:mt-0">
                  <p class="text-lg font-medium text-gray-900">
                    ₹<%= item.product.price * item.quantity %>
                  </p>
                </div>
              </div>
              <div class="mt-4 flex justify-between items-center">
                <div class="flex items-center border border-gray-300 rounded">
                  <form method="POST" action="/cart/decrease/<%= item.product._id %>">
                    <button class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">-</button>
                  </form>
                  <span class="px-4 py-1 text-gray-900"><%= item.quantity %></span>
                  <form method="POST" action="/cart/increase/<%= item.product._id %>">
                    <button class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">+</button>
                  </form>
                </div>
               
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

   <!-- Order Summary -->
<div class="lg:w-1/3 hidden lg:block">
  <div class="bg-white rounded-lg shadow-md p-6 sticky top-24">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Order Summary</h2>
    <div class="space-y-4">
      <div class="flex justify-between">
        <span class="text-gray-600">Subtotal (<%= cart.length %> items)</span>
        <span class="font-medium text-gray-900">₹<%= total %></span>
      </div>
      
      <!-- Shipping Cost Logic -->
      <% const numericTotal = parseFloat(total); %>
      <% const shippingCharge = numericTotal >= 499 ? 0 : 40; %>
      <div class="flex justify-between">
        <span class="text-gray-600">Shipping</span>
        <span class="font-medium text-gray-900">
          <%= shippingCharge === 0 ? "Free" : `₹${shippingCharge}` %>
        </span>
      </div>

      <!-- Subtotal (Including Shipping and Taxes) -->
      <div class="flex justify-between">
        <span class="text-gray-600">Subtotal (Including all taxes and shipping)</span>
        <span class="font-medium text-gray-900">₹<%= (numericTotal + shippingCharge).toFixed(2) %></span>
      </div>

      <!-- Total -->
      <div class="border-t border-gray-200 pt-4 flex justify-between">
        <span class="text-lg font-medium text-gray-900">Total</span>
        <span class="text-lg font-bold text-gray-900">
          ₹<%= (numericTotal + shippingCharge).toFixed(2) %>
        </span>
      </div>

    </div>
    <a
  href="<%= user ? '/cart/checkout' : encodeURI('/auth/login?redirect=/cart/checkout') %>"
  class="mt-6 w-full block text-center bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded"
>
  <%= user ? 'Proceed to Checkout' : 'Login to Checkout' %>
</a>

    <a
      href="/"
      class="mt-4 w-full block text-center text-purple-600 hover:underline"
    >
      Continue Shopping
    </a>
  </div>
</div>


  <!-- Mobile Continue Shopping -->
  <div class="mt-6 lg:hidden">
    <a
      href="/"
      class="block w-full text-center bg-white text-purple-600 font-bold py-2 px-4 rounded border border-purple-600 mb-4"
    >
      Continue Shopping
    </a>
  </div>
  <% } %>
</div>
</div>

<%- include('./partials/footer'); %>
