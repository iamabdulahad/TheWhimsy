<%- include('partials/header') %>


<!-- Navbar with Go Back Button -->
<nav class="bg-white  p-4">
    <div class="max-w-5xl mx-auto flex items-center">
      <button onclick="window.history.back()" class="flex items-center text-black hover:text-blue-800 font-semibold">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
        Go Back
      </button>
    </div>
  </nav>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-rose-700 mb-8 text-center">Frequently Asked Questions</h1>

    <div class="space-y-6">
      <div>
        <h2 class="text-xl font-semibold mb-2">Q: How can I contact customer support?</h2>
        <p class="text-gray-700">You can reach us via the Contact Us page or email us at littlejerry@gmail.com.</p>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2">Q: What is your return policy?</h2>
        <p class="text-gray-700">We accept returns within 7 days of delivery. Products must be unused and in original packaging.</p>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2">Q: How long does shipping take?</h2>
        <p class="text-gray-700">Orders are processed within 1-2 business days and typically delivered within 5-7 days.</p>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2">Q: Do you offer international shipping?</h2>
        <p class="text-gray-700">Currently, we only ship within India. International shipping coming soon!</p>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2">Q: How do I track my order?</h2>
        <p class="text-gray-700">After your order is shipped, you can check it in the 'My Orders' section.</p>
      </div>
    </div>

  </section>

  <%- include('partials/footer') %> <!-- Footer -->

</body>
</html>
