<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <title>Forgot Password</title>
  </head>
  <body class="bg-gray-100">
    <div class="min-h-screen flex items-center justify-center px-4">
      <div class="max-w-md w-full bg-white p-8 rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold text-center text-purple-700 mb-6">Forgot Password</h2>

        <% if (messages.error) { %>
          <div class="mb-4 text-red-600 text-sm"><%= messages.error %></div>
        <% } %>
        <% if (messages.success) { %>
          <div class="mb-4 text-green-600 text-sm"><%= messages.success %></div>
        <% } %>

        <form action="/users/forgot-password" method="POST" class="space-y-5">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500 sm:text-sm"
              placeholder="you@example.com"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-md"
          >
            Send Reset Link
          </button>

          <div class="text-sm text-center mt-2">
            <a href="/users/login" class="text-purple-600 hover:text-purple-800">Back to Login</a>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
