<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whimsy</title>
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
     <!-- Swiper CSS -->
    <!-- <link rel="stylesheet" href="/swiper/swiper-bundle.min.css" /> -->
   
    <script src="https://unpkg.com/@studio-freight/lenis"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Lobster&display=swap" rel="stylesheet">
    


    <link href="/css/output.css" rel="stylesheet">
</head>


 <!-- Fixed Wrapper -->
 <div class="fixed top-0 left-0 w-full z-50">
    <!-- Notification Bar -->
    <div class="w-full h-7 bg-[#B098E0] text-center p-1 font-bold text-black tracking-wide">
      <h1>Free Delivery on orders above 499₹</h1>
    </div>

    <!-- Navbar -->

<nav class="w-full h-20 bg-[#FFFFFF] flex md:justify-evenly relative justify-between px-6 py-2 items-center shadow-md">
    
  <!-- Shop Menu -->
  <div class="w-full relative parent z-10">
      <div class="relative group left-80 w-20">
          <h1 class="hidden lg:block text-xl uppercase font-semibold cursor-pointer hover:bg-red-400 hover:-rotate-3 w-fit p-2">
              Shop
          </h1>
          <div class="absolute w-screen top-full -left-80 h-[25vh] bg-transparent shadow-lg hidden group-hover:flex items-center justify-center transition-transform duration-300">
              <div class="flex justify-start">
                  <a href="/products?category=Candy" class="px-44 py-20 bg-[#241F21] border-white border-r-[1px] transition-transform duration-300 hover:bg-[#F2F0EB] hover:-rotate-6 hover:text-black text-white text-2xl font-bold uppercase">Candy</a>
                  <a href="/products?category=Mouth+Fresheners" class="px-44 py-20 bg-[#241F21] border-white border-r-[1px] transition-transform duration-300 hover:bg-[#F2F0EB] hover:-rotate-6 hover:text-black text-white text-2xl font-bold uppercase">Mouth fresheners</a>
                  <a href="/products?category=Fruit+Jelly" class="px-44 py-20 bg-[#241F21] border-white border-r-[1px] transition-transform duration-300 hover:bg-[#F2F0EB] hover:-rotate-6 hover:text-black text-white text-2xl font-bold uppercase">Fruit jelly</a>
                  <a href="/products" class="px-44 py-20 bg-[#241F21] border-white border-l-[1px] transition-transform duration-300 hover:bg-[#F2F0EB] hover:-rotate-6 hover:text-black text-white text-2xl font-bold uppercase">Shop All</a>
              </div>
          </div>
      </div>
  </div>

  <!-- Logo -->
  <a href="/" class="absolute left-20 md:left-1/2 transform -translate-x-1/2 z-50">
      <h1 class="text-3xl md:text-4xl font-thin tracking-wide" style="font-family: 'Lobster', cursive;">
          Whimsy
      </h1>
  </a>

  <!-- Right Icons -->
  <div class="flex gap-5 items-center relative z-50 lg:right-72">
      
      <!-- Profile Icon -->
      <% if (!user) { %>
      <a href="/users/login">
          <i class="ri-user-line text-2xl cursor-pointer"></i>
      </a>
      <% } else { %>
      <div class="cursor-pointer flex items-center gap-2 relative group">
          <div class="bg-purple-500 w-8 h-8 text-white flex items-center justify-center rounded-full uppercase">
              <%= user.name ? user.name.charAt(0) : 'U' %>
          </div>

          <!-- Profile Dropdown (Only visible on hover over the Profile icon) -->
          <div class="hidden group-hover:flex flex-col absolute right-0 top-8 bg-white shadow-lg rounded-lg z-50 min-w-[150px] overflow-hidden border border-gray-200">
              <a href="/users/profile" class="px-4 py-2 text-sm hover:bg-gray-100">My Profile</a>
              <a href="/users/my-orders" class="px-4 py-2 text-sm hover:bg-gray-100">My Orders</a>
              <a href="/users/logout" class="px-4 py-2 text-sm text-red-600 hover:bg-red-50">Logout</a>
          </div>
      </div>
      <% } %>

      <!-- Cart Icon -->
      <span class="relative inline-block">
          <a href="/cart" class="block">
              <i class="ri-shopping-cart-line text-2xl <%= cartItemCount > 0 ? 'text-black' : 'text-gray-700' %>"></i>

              <% if (cartItemCount > 0) { %>
              <span class="absolute -top-1.5 -right-2 bg-black text-white rounded-full text-[10px] px-1.5 py-0.5 leading-none">
                  <%= cartItemCount %>
              </span>
              <% } %>
          </a>
      </span>

  </div>
</nav>

    
  </div>

  <!-- Spacer exactly = notification(8) + navbar(20) = 28 units = 7rem -->
  <div class="h-20 mb-8"></div>






